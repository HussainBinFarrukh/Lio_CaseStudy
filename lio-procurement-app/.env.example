# Copy to .env and adjust: `cp .env.example .env`. docker compose reads this file.

# Required for PDF extraction (everything else works without it).
OPENAI_API_KEY=
# Model used for extraction; must support Structured Outputs.
OPENAI_MODEL=gpt-4o-mini
# Per-attempt timeout (seconds) and automatic retries for transient failures.
OPENAI_TIMEOUT_SECONDS=45
OPENAI_MAX_RETRIES=2

# Signing secret for login tokens. Change this outside local development.
JWT_SECRET=dev-secret-change-in-production
